# Streamlit Cloud Secrets Template
# Copy this to secrets.toml and fill in your values
# Or add these in Streamlit Cloud dashboard under Settings > Secrets

# LiteLLM API Configuration
LITELLM_API_KEY = "your-opus-api-key"
LITELLM_BASE_URL = "https://llmgateway.internal.formation.bio"
LITELLM_MODEL = "claude-opus-4-5"
LITELLM_HAIKU_API_KEY = "your-haiku-api-key"
LITELLM_SONNET_API_KEY = "your-sonnet-api-key"

# Snowflake Configuration
SNOWFLAKE_ACCOUNT = "your-account"
SNOWFLAKE_USER = "your-user"
SNOWFLAKE_WAREHOUSE = "your-warehouse"
SNOWFLAKE_DATABASE = "REFERENCE_PROD"
SNOWFLAKE_SCHEMA = "SILVER_PUBMED"
SNOWFLAKE_ROLE = "PUBLIC"
SNOWFLAKE_PASSWORD = "your-password-or-leave-empty-for-sso"

# Optional
NCBI_API_KEY = ""
